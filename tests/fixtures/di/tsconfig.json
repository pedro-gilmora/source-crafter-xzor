{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [".", ".xzor"],
    "paths": {
      "@xzor/runtime": ["../../../runtime/index.ts"]
    }
  },
  "include": ["**/*.ts", ".xzor/**/*.ts"]
}
