{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "ESNext.Disposable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [".", ".xzor"],
    "paths": {
      "@source-crafter/xzor-runtime": ["../../../runtime/index.ts"],
      "@source-crafter/xzor-runtime/model": ["../../../runtime/model.ts"],
      "@source-crafter/xzor-runtime/server": ["../../../runtime/server.ts"]
    }
  },
  "include": ["**/*.ts", ".xzor/**/*.ts"]
}
