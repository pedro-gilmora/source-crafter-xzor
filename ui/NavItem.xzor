@import { NavLink } from "@source-crafter/xzor-runtime"
@import { type IconName } from "@source-crafter/xzor-ui"
@import Icon from "./Icon.xzor"

@code {
  href = "";
  label = "";
  icon?: IconName;
  match: "prefix" | "exact" = "prefix";
}

<NavLink href="@href" match="@match">
  @if (icon) {
    <Icon name="@(icon!)" />
  }
  <span>@label</span>
</NavLink>
