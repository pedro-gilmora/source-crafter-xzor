@import Button from "./Button.xzor"

@code {
  id = "";
  title = "";
  /** The edge it slides in from. */
  side: "bottom" | "end" | "start" = "bottom";
  dialog?: HTMLDialogElement;

  show() {
    this.dialog?.showModal();
  }

  close() {
    this.dialog?.close();
  }
}

<dialog class="xz-sheet" id="@id" data-side="@side" data-depth="3" closedby="any" aria-label="@title" @ref="dialog">
  <header>
    <h2>@title</h2>
    <Button icon="x" label="Close" variant="ghost" size="sm" closes="@id" />
  </header>
  <div class="xz-sheet-body">@slot</div>
  @if (this.slots.actions) {
    <footer>@slot:actions</footer>
  }
</dialog>
