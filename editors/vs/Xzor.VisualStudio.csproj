<Project>
  <!-- Visual Studio 2022 and 2026 extension: the xzor language server and TextMate grammar.
       Build with editors/vs/build.ps1 (Visual Studio's MSBuild; `-offline` compiles against the installed Visual Studio). -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>Xzor.VisualStudio</RootNamespace>
    <AssemblyName>Xzor.VisualStudio</AssemblyName>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <DeployExtension>false</DeployExtension>
    <TargetVsixContainerName>xzor-vs.vsix</TargetVsixContainerName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120" PrivateAssets="all" />
  </ItemGroup>

  <!-- From NuGet by default; `/p:VsInstallRoot=<Visual Studio folder>` compiles against an installed Visual Studio instead (offline builds). -->
  <ItemGroup Condition="'$(VsInstallRoot)' == ''">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(VsInstallRoot)' != ''">
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\LanguageServer\Microsoft.VisualStudio.LanguageServer.Client.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\CommonExtensions\Microsoft\Editor\Microsoft.VisualStudio.CoreUtility.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.15.0.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.Framework.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Shell.Interop.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Threading.17.x\Microsoft.VisualStudio.Threading.dll" Private="false" />
    <Reference Include="$(VsInstallRoot)\Common7\IDE\PrivateAssemblies\Microsoft.VisualStudio.Validation.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest" SubType="Designer" />
    <Content Include="xzor.pkgdef" IncludeInVSIX="true" />
    <Content Include="..\vscode\syntaxes\xzor.tmLanguage.json" Link="Grammars\xzor.tmLanguage.json" IncludeInVSIX="true" />
    <Content Include="..\vscode\syntaxes\xzor-css.tmLanguage.json" Link="Grammars\xzor-css.tmLanguage.json" IncludeInVSIX="true" />
    <Content Include="..\vscode\language-configuration.json" Link="Grammars\xzor.language-configuration.json" IncludeInVSIX="true" />
    <!-- Packaging copies the host binary here, so the extension works without a workspace build or npm install. -->
    <Content Include="server\xzor.exe" Condition="Exists('server\xzor.exe')" IncludeInVSIX="true" />
  </ItemGroup>



  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />
</Project>
