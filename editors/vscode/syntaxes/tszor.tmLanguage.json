{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.tszor",
  "name": "TSZor",
  "patterns": [{ "include": "#markup" }],
  "injections": {
    "L:meta.embedded.block.typescript - comment - string": {
      "comment": "Markup used as a value inside @code and @{ }, where TypeScript would read a cast.",
      "patterns": [{ "include": "#code-markup-value" }]
    }
  },
  "repository": {
    "code-markup-value": {
      "comment": "Starts at the whitespace before `<` so it wins over TypeScript's cast rule, which starts there too.",
      "begin": "(?:(?<![\\w$.)\\]>])|(?<=\\breturn|\\byield|\\bawait))\\s+(?=@?<[A-Za-z][\\w.:-]*[\\s/>])",
      "end": "(?<=>)",
      "patterns": [{ "include": "#code-void-element" }, { "include": "#code-element" }]
    },
    "code-void-element": {
      "name": "meta.tag.tszor",
      "begin": "(@)?(<)(area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "entity.name.tag.html" }
      },
      "end": "/?>",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#tag-attributes" }]
    },
    "code-element": {
      "begin": "(@)?(<)(?:([A-Z][\\w.]*)|([a-z][\\w:-]*))(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "support.class.component.tszor" },
        "4": { "name": "entity.name.tag.html" }
      },
      "end": "(/>)|(</)(?:([A-Z][\\w.]*)|([a-z][\\w:-]*))\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "support.class.component.tszor" },
        "4": { "name": "entity.name.tag.html" },
        "5": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#tag-attributes" },
        {
          "comment": "Children run from the start tag's `>` up to the matching close tag.",
          "begin": ">",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
          "end": "(?=</)",
          "patterns": [
            { "include": "#razor-comment" },
            { "include": "#comment" },
            { "include": "#code-void-element" },
            { "include": "#code-element" },
            { "include": "#escape" },
            { "include": "#cascade" },
            { "include": "#slot-definition-args" },
            { "include": "#slot-fill-params" },
            { "include": "#slot" },
            { "include": "#switch" },
            { "include": "#control" },
            { "include": "#explicit" },
            { "include": "#implicit-call" },
            { "include": "#implicit" },
            { "include": "#entity" }
          ]
        }
      ]
    },
    "markup": {
      "patterns": [
        { "include": "#razor-comment" },
        { "include": "#comment" },
        { "include": "#code-block" },
        { "include": "#statements" },
        { "include": "#class-directives" },
        { "include": "#line-text" },
        { "include": "#page" },
        { "include": "#typeparam" },
        { "include": "#inject" },
        { "include": "#import" },
        { "include": "#escape" },
        { "include": "#cascade" },
        { "include": "#slot-definition-args" },
        { "include": "#slot-fill-params" },
        { "include": "#slot" },
        { "include": "#switch" },
        { "include": "#control" },
        { "include": "#explicit" },
        { "include": "#implicit-call" },
        { "include": "#implicit" },
        { "include": "#end-tag" },
        { "include": "#start-tag" },
        { "include": "#entity" }
      ]
    },
    "razor-comment": {
      "name": "comment.block.tszor",
      "begin": "@\\*",
      "end": "\\*@"
    },
    "directive-comment": {
      "patterns": [
        { "name": "comment.line.double-slash.tszor", "match": "//.*$" },
        { "include": "#razor-comment" }
      ]
    },
    "statements": {
      "comment": "@{ ... }: TypeScript statements inside the template.",
      "begin": "(@)(?=\\{)",
      "beginCaptures": { "1": { "name": "keyword.control.transition.tszor" } },
      "end": "(?<=\\})",
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts#decl-block" }]
    },
    "class-directives": {
      "begin": "(?<![[:alnum:]])(@)(inherits|implements|attribute)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.directive.tszor" }
      },
      "end": "$",
      "contentName": "meta.embedded.line.typescript",
      "patterns": [{ "include": "#directive-comment" }, { "include": "source.ts#expression" }]
    },
    "line-text": {
      "match": "(@:)",
      "captures": { "1": { "name": "keyword.control.transition.tszor" } }
    },
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "captures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "entity": {
      "name": "constant.character.entity.html",
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);"
    },
    "escape": {
      "name": "constant.character.escape.tszor",
      "match": "@@"
    },
    "code-block": {
      "begin": "(?<![[:alnum:]])(@)(code)\\s*(?=\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.directive.tszor" }
      },
      "end": "(?<=\\})",
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts#class-or-interface-body" }]
    },
    "page": {
      "match": "(?<![[:alnum:]])(@)(page)\\s+(\"[^\"]*\")[ \\t]*(//.*$)?",
      "captures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.directive.tszor" },
        "3": { "name": "string.quoted.double.tszor" },
        "4": { "name": "comment.line.double-slash.tszor" }
      }
    },
    "typeparam": {
      "match": "(?<![[:alnum:]])(@)(typeparam)\\s+([_$[:alpha:]][_$[:alnum:]]*)((?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^/@]|/(?!/))*)(//.*$)?",
      "captures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.directive.tszor" },
        "3": { "name": "entity.name.type.parameter.tszor" },
        "4": { "patterns": [{ "include": "source.ts#type" }] },
        "5": { "name": "comment.line.double-slash.tszor" }
      }
    },
    "inject": {
      "match": "(?<![[:alnum:]])(@)(inject)\\s+(.+?)\\s+([_$[:alpha:]][_$[:alnum:]]*)[ \\t]*(?:(//.*)$|(?=@\\*)|$)",
      "captures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.directive.tszor" },
        "3": { "patterns": [{ "include": "source.ts#type" }] },
        "4": { "name": "variable.other.readwrite.tszor" },
        "5": { "name": "comment.line.double-slash.tszor" }
      }
    },
    "import": {
      "begin": "(?<![[:alnum:]])(@)(?=import\\b)",
      "beginCaptures": { "1": { "name": "keyword.control.transition.tszor" } },
      "end": "$",
      "contentName": "meta.embedded.line.typescript",
      "patterns": [
        { "include": "#directive-comment" },
        {
          "comment": "Not source.ts#import-declaration: it swallows the line ending after a `//` comment and never ends.",
          "match": "\\bimport\\b(?:\\s+(type)(?!\\s+from))?",
          "name": "keyword.control.import.ts",
          "captures": { "1": { "name": "keyword.control.type.ts" } }
        },
        { "match": "\\bfrom\\b", "name": "keyword.control.from.ts" },
        { "include": "source.ts#string" },
        { "include": "source.ts#import-export-declaration" }
      ]
    },
    "explicit": {
      "begin": "(?<![[:alnum:]])(@)(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "punctuation.section.embedded.begin.tszor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.tszor" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#expression" }]
    },
    "implicit-call": {
      "begin": "(?<![[:alnum:]])(@)([_$[:alpha:]][_$[:alnum:]]*(?:\\??\\.[_$[:alpha:]][_$[:alnum:]]*)*)(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "variable.other.readwrite.tszor" },
        "3": { "name": "punctuation.section.embedded.begin.tszor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.tszor" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#expression" }]
    },
    "implicit": {
      "match": "(?<![[:alnum:]])(@)([_$[:alpha:]][_$[:alnum:]]*(?:\\??\\.[_$[:alpha:]][_$[:alnum:]]*)*)",
      "captures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "variable.other.readwrite.tszor" }
      }
    },
    "condition": {
      "begin": "\\(",
      "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.tszor" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.parens.end.tszor" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "block": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.tszor" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.tszor" } },
      "patterns": [{ "include": "#markup" }]
    },
    "control": {
      "comment": "@if/@for, plus `else` chains; ends after a block that is not followed by `else` on the same line.",
      "begin": "(?:(?<![[:alnum:]])(@)(if|for|while)\\b|^\\s*(else)\\b(?=\\s*(?:if\\s*\\(|\\{)))",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" },
        "3": { "name": "keyword.control.tszor" }
      },
      "end": "(?<=\\})(?!\\s*else\\b)",
      "patterns": [
        { "match": "\\b(else|if)\\b", "name": "keyword.control.tszor" },
        { "include": "#condition" },
        { "include": "#block" }
      ]
    },
    "slot-definition-args": {
      "comment": "@slot:name(args): arguments are TypeScript expressions.",
      "begin": "(?<![[:alnum:]])(@)(slot)(:)([_$[:alpha:]][_$[:alnum:]]*)(?=\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" },
        "3": { "name": "punctuation.separator.slot.tszor" },
        "4": { "name": "entity.name.function.slot.tszor" }
      },
      "end": "(?<=\\))",
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.tszor" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parens.end.tszor" } },
          "contentName": "meta.embedded.expression.typescript",
          "patterns": [{ "include": "source.ts#expression" }]
        }
      ]
    },
    "cascade": {
      "comment": "@cascade:name(value[, fixed]) { body }: the value is a TypeScript expression.",
      "begin": "(?<![[:alnum:]])(@)(cascade)(:)([_$[:alpha:]][_$[:alnum:]]*)[ \\t]*(?=\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" },
        "3": { "name": "punctuation.separator.cascade.tszor" },
        "4": { "name": "variable.other.constant.cascade.tszor" }
      },
      "end": "(?<=\\))",
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.parens.begin.tszor" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parens.end.tszor" } },
          "contentName": "meta.embedded.expression.typescript",
          "patterns": [
            {
              "match": "(,)\\s*(fixed)\\b(?=\\s*\\))",
              "captures": {
                "1": { "name": "punctuation.separator.comma.ts" },
                "2": { "name": "keyword.other.fixed.tszor" }
              }
            },
            { "include": "source.ts#expression" }
          ]
        }
      ]
    },
    "slot-fill-params": {
      "comment": "@slot name(params) inside a component tag: a TypeScript parameter list.",
      "begin": "(?<![[:alnum:]])(@)(slot)(?:[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?[ \\t]*(?=\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" },
        "3": { "name": "entity.name.function.slot.tszor" }
      },
      "end": "(?<=\\))",
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#function-parameters" }]
    },
    "slot": {
      "match": "(?<![[:alnum:]])(@)(slot)(?:(:)([_$[:alpha:]][_$[:alnum:]]*)|[ \\t]+([_$[:alpha:]][_$[:alnum:]]*)(?=\\s*\\{))?",
      "captures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" },
        "3": { "name": "punctuation.separator.slot.tszor" },
        "4": { "name": "entity.name.function.slot.tszor" },
        "5": { "name": "entity.name.function.slot.tszor" }
      }
    },
    "switch": {
      "begin": "(?<![[:alnum:]])(@)(switch)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.tszor" },
        "2": { "name": "keyword.control.tszor" }
      },
      "end": "(?<=\\})",
      "patterns": [
        { "include": "#condition" },
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.tszor" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.tszor" } },
          "patterns": [
            {
              "begin": "(?:^|(?<=:))\\s*(case)\\b",
              "beginCaptures": { "1": { "name": "keyword.control.tszor" } },
              "end": ":",
              "endCaptures": { "0": { "name": "punctuation.separator.case.tszor" } },
              "contentName": "meta.embedded.expression.typescript",
              "patterns": [{ "include": "source.ts#expression" }]
            },
            {
              "match": "(?:^|(?<=:))\\s*(default)\\s*(:)",
              "captures": {
                "1": { "name": "keyword.control.tszor" },
                "2": { "name": "punctuation.separator.case.tszor" }
              }
            },
            {
              "match": "\\b(break)\\s*(;)",
              "captures": {
                "1": { "name": "keyword.control.tszor" },
                "2": { "name": "punctuation.terminator.statement.tszor" }
              }
            },
            { "include": "#markup" }
          ]
        }
      ]
    },
    "end-tag": {
      "match": "(</)(?:([A-Z][\\w.]*)|([a-zA-Z][\\w:-]*))\\s*(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "support.class.component.tszor" },
        "3": { "name": "entity.name.tag.html" },
        "4": { "name": "punctuation.definition.tag.end.html" }
      }
    },
    "start-tag": {
      "name": "meta.tag.tszor",
      "begin": "(<)(?:([A-Z][\\w.]*)|([a-zA-Z][\\w:-]*))",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "support.class.component.tszor" },
        "3": { "name": "entity.name.tag.html" }
      },
      "end": "/?>",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#tag-attributes" }]
    },
    "tag-attributes": {
      "patterns": [
        { "include": "#event-attribute" },
        { "include": "#quoted-attribute" },
        { "match": "(?<=\\s)@[\\w-]+(?::[\\w-]+)?(?=[\\s/>])", "name": "entity.other.attribute-name.html" },
        { "include": "#explicit" },
        { "include": "#implicit-call" },
        { "include": "#implicit" },
        { "match": "[^\\s=/>\"']+", "name": "entity.other.attribute-name.html" },
        { "match": "=", "name": "punctuation.separator.key-value.html" }
      ]
    },
    "event-attribute": {
      "begin": "(@[A-Za-z][\\w:.-]*)\\s*(=)\\s*([\"'])",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.html entity.other.attribute-name.event.tszor" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "punctuation.definition.string.begin.html" }
      },
      "end": "\\3",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#expression" }]
    },
    "quoted-attribute": {
      "begin": "([^\\s=/>\"'@][^\\s=/>\"']*)\\s*(=)\\s*([\"'])",
      "beginCaptures": {
        "1": { "name": "entity.other.attribute-name.html" },
        "2": { "name": "punctuation.separator.key-value.html" },
        "3": { "name": "string.quoted.html punctuation.definition.string.begin.html" }
      },
      "end": "\\3",
      "endCaptures": { "0": { "name": "string.quoted.html punctuation.definition.string.end.html" } },
      "contentName": "string.quoted.html",
      "patterns": [
        { "include": "#escape" },
        { "include": "#explicit" },
        { "include": "#implicit-call" },
        { "include": "#implicit" },
        { "include": "#entity" }
      ]
    }
  }
}
