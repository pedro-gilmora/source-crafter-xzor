      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "punctuation.section.embedded.begin.xzor" }
      },
      "end": "(\\])((?:\\??\\.#?[_$[:alpha:]][_$[:alnum:]]*)*)",
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.xzor" },
        "2": { "name": "variable.other.readwrite.xzor" }
      },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#expression" }]
    },
    "implicit-call": {
      "begin": "(?<![[:alnum:]])(@)(#?[_$[:alpha:]][_$[:alnum:]]*(?:\\??\\.#?[_$[:alpha:]][_$[:alnum:]]*)*)(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "variable.other.readwrite.xzor" },
        "3": { "name": "punctuation.section.embedded.begin.xzor" }
