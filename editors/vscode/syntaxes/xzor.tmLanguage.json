    "slot-definition-args": {
      "comment": "@slot:name(args): arguments are TypeScript expressions.",
      "begin": "(?<![[:alnum:]])(@)(slot)(:)([_$[:alpha:]][_$[:alnum:]]*)(?=\\()",
