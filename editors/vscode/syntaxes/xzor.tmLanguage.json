      "endCaptures": { "0": { "name": "punctuation.section.parens.end.xzor" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "block": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.block.begin.xzor" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.block.end.xzor" } },
      "patterns": [{ "include": "#markup" }]
    },
    "control": {
      "comment": "@if/@for, plus `else` chains; ends after a block that is not followed by `else` on the same line.",
      "begin": "(?:(?<![[:alnum:]])(@)((?:show:)?if|for|while)\\b|^\\s*(else)\\b(?=\\s*(?:if\\s*\\(|\\{)))",
