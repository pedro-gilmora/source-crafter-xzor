{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "source.xzor",
  "fileTypes": ["xzor"],
  "name": "XZor",
  "patterns": [{ "include": "#markup" }],
  "injections": {
    "L:meta.embedded.block.css - comment - string": {
      "comment": "@expr, @(expr), @if/else and @@ anywhere inside a <style>, nested CSS rules included.",
      "patterns": [{ "include": "#css-expr" }]
    },
    "L:meta.embedded.block.typescript - comment - string": {
      "comment": "Markup used as a value inside @code and @{ }, where TypeScript would read a cast.",
      "patterns": [{ "include": "#code-markup-value" }]
    }
  },
  "repository": {
    "code-markup-value": {
      "comment": "Starts at the whitespace before `<` so it wins over TypeScript's cast rule, which starts there too.",
      "begin": "(?:(?<![\\w$.)\\]>])|(?<=\\breturn|\\byield|\\bawait))\\s+(?=@?<[A-Za-z][\\w.:-]*[\\s/>])",
      "end": "(?<=>)",
      "patterns": [{ "include": "#code-void-element" }, { "include": "#code-element" }]
    },
    "code-void-element": {
      "name": "meta.tag.xzor",
      "begin": "(@)?(<)(area|base|br|col|embed|hr|img|input|link|meta|source|track|wbr)(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "entity.name.tag.html" }
      },
      "end": "/?>",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#tag-attributes" }]
    },
    "code-element": {
      "begin": "(@)?(<)(?:([A-Z][\\w.]*)|([a-z][\\w:-]*))(?=[\\s/>])",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "support.class.component.xzor" },
        "4": { "name": "entity.name.tag.html" }
      },
      "end": "(/>)|(</)(?:([A-Z][\\w.]*)|([a-z][\\w:-]*))\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.html" },
        "2": { "name": "punctuation.definition.tag.begin.html" },
        "3": { "name": "support.class.component.xzor" },
        "4": { "name": "entity.name.tag.html" },
        "5": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#tag-attributes" },
        {
          "comment": "Children run from the start tag's `>` up to the matching close tag.",
          "begin": ">",
          "beginCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
          "end": "(?=</)",
          "patterns": [
            { "include": "#razor-comment" },
            { "include": "#comment" },
            { "include": "#code-void-element" },
            { "include": "#code-element" },
            { "include": "#escape" },
            { "include": "#cascade" },
            { "include": "#slot-definition-args" },
            { "include": "#slot-fill-params" },
            { "include": "#slot" },
            { "include": "#switch" },
            { "include": "#control" },
            { "include": "#explicit" },
            { "include": "#array" },
            { "include": "#implicit-call" },
            { "include": "#implicit" },
            { "include": "#entity" }
          ]
        }
      ]
    },
    "markup": {
      "patterns": [
        { "include": "#razor-comment" },
        { "include": "#comment" },
        { "include": "#code-block" },
        { "include": "#module-block" },
        { "include": "#statements" },
        { "include": "#class-directives" },
        { "include": "#fine" },
        { "include": "#line-text" },
        { "include": "#routes-block" },
        { "include": "#page" },
        { "include": "#typeparam" },
        { "include": "#inject" },
        { "include": "#import" },
        { "include": "#escape" },
        { "include": "#parent-attribute" },
        { "include": "#once" },
        { "include": "#cascade" },
        { "include": "#slot-definition-args" },
        { "include": "#slot-fill-params" },
        { "include": "#slot" },
        { "include": "#switch" },
        { "include": "#control" },
        { "include": "#explicit" },
        { "include": "#array" },
        { "include": "#implicit-call" },
        { "include": "#implicit" },
        { "include": "#end-tag" },
        { "include": "#style-block" },
        { "include": "#start-tag" },
        { "include": "#entity" }
      ]
    },
    "razor-comment": {
      "name": "comment.block.xzor",
      "begin": "@\\*",
      "end": "\\*@"
    },
    "directive-comment": {
      "patterns": [
        { "name": "comment.line.double-slash.xzor", "match": "//.*$" },
        { "include": "#razor-comment" }
      ]
    },
    "statements": {
      "comment": "@{ ... }: TypeScript statements inside the template.",
      "begin": "(@)(?=\\{)",
      "beginCaptures": { "1": { "name": "keyword.control.transition.xzor" } },
      "end": "(?<=\\})",
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts#decl-block" }]
    },
    "class-directives": {
      "begin": "(?<![[:alnum:]])(@)(inherits|implements|attribute)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" }
      },
      "end": "$",
      "contentName": "meta.embedded.line.typescript",
      "patterns": [{ "include": "#directive-comment" }, { "include": "source.ts#expression" }]
    },
    "fine": {
      "comment": "@fine (the default: DOM bindings, no render pass), @render (a virtual-DOM render pass instead), @async (loaded on first use), @cached (kept when it leaves the tree).",
      "begin": "(?<![[:alnum:]])(@)(fine|render|async|cached)(?![[:alnum:]_$])",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" }
      },
      "end": "$",
      "patterns": [{ "include": "#directive-comment" }]
    },
    "line-text": {
      "match": "(@:)",
      "captures": { "1": { "name": "keyword.control.transition.xzor" } }
    },
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "captures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "entity": {
      "name": "constant.character.entity.html",
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);"
    },
    "escape": {
      "name": "constant.character.escape.xzor",
      "match": "@@"
    },
    "code-block": {
      "begin": "(?<![[:alnum:]])(@)(code)\\s*(?=\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" }
      },
      "end": "(?<=\\})",
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts#class-or-interface-body" }]
    },
    "module-block": {
      "begin": "(?<![[:alnum:]])(@)(module)\\s*(?=\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" }
      },
      "end": "(?<=\\})",
      "contentName": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "page": {
      "match": "(?<![[:alnum:]])(@)(page)\\s+(\"[^\"]*\")(?:[ \\t]+(as)[ \\t]+([_$[:alpha:]][_$[:alnum:]]*))?[ \\t]*(//.*$)?",
      "captures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" },
        "3": { "name": "string.quoted.double.xzor" },
        "4": { "name": "keyword.control.as.xzor" },
        "5": { "name": "variable.other.constant.route.xzor" },
        "6": { "name": "comment.line.double-slash.xzor" }
      }
    },
    "routes-block": {
      "comment": "@ClientRoutes(route) { sections }: only sections are recognized directly inside the braces.",
      "begin": "(?<![[:alnum:]])(@)(ClientRoutes|ServerRoutes)[ \\t]*(?=\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" }
      },
      "end": "(?<=\\})",
      "patterns": [
        { "include": "#route-params" },
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.section.block.begin.xzor" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.section.block.end.xzor" } },
          "patterns": [
            { "include": "#razor-comment" },
            { "include": "#comment" },
            { "include": "#route-section" }
          ]
        }
      ]
    },
    "route-params": {
      "match": "(\\()[ \\t]*([_$[:alpha:]][_$[:alnum:]]*\\??)?[ \\t]*(\\))",
      "captures": {
        "1": { "name": "punctuation.section.parens.begin.xzor" },
        "2": { "name": "variable.parameter.xzor" },
        "3": { "name": "punctuation.section.parens.end.xzor" }
      }
    },
    "route-section": {
      "comment": "@tag(page) { }, @/re/flags(page?) { }, @\"pattern\"(page?) { }, @notFound { }, @catch(e) { }, @default(page) { }.",
      "begin": "(?<![[:alnum:]])(@)(?=[/\"_$[:alpha:]])",
      "beginCaptures": { "1": { "name": "keyword.control.transition.xzor" } },
      "end": "(?<=\\})",
      "patterns": [
        { "match": "\\G(notFound|catch|default)\\b", "name": "keyword.control.xzor" },
        { "match": "\\G[_$[:alpha:]][_$[:alnum:]]*", "name": "variable.other.constant.route.xzor" },
        { "match": "\\G\"(?:[^\"\\\\]|\\\\.)*\"", "name": "string.quoted.double.xzor" },
        {
          "name": "string.regexp.ts",
          "begin": "\\G/(?=(?:[^/\\\\\\[\\n]|\\\\.|\\[(?:[^\\]\\\\\\n]|\\\\.)*\\])+/)",
          "end": "/[dgimsuvy]*",
          "patterns": [{ "include": "source.ts#regexp" }]
        },
        { "include": "#route-params" },
        { "include": "#block" }
      ]
    },
    "typeparam": {
      "match": "(?<![[:alnum:]])(@)(typeparam)\\s+([_$[:alpha:]][_$[:alnum:]]*)((?:\"(?:[^\"\\\\]|\\\\.)*\"|'(?:[^'\\\\]|\\\\.)*'|[^/@]|/(?!/))*)(//.*$)?",
      "captures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" },
        "3": { "name": "entity.name.type.parameter.xzor" },
        "4": { "patterns": [{ "include": "source.ts#type" }] },
        "5": { "name": "comment.line.double-slash.xzor" }
      }
    },
    "inject": {
      "match": "(?<![[:alnum:]])(@)(inject)\\s+(.+?)\\s+([_$[:alpha:]][_$[:alnum:]]*)[ \\t]*(?:(//.*)$|(?=@\\*)|$)",
      "captures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "keyword.control.directive.xzor" },
        "3": { "patterns": [{ "include": "source.ts#type" }] },
        "4": { "name": "variable.other.readwrite.xzor" },
        "5": { "name": "comment.line.double-slash.xzor" }
      }
    },
    "import": {
      "begin": "(?<![[:alnum:]])(@)(?=import\\b)",
      "beginCaptures": { "1": { "name": "keyword.control.transition.xzor" } },
      "end": "$",
      "contentName": "meta.embedded.line.typescript",
      "patterns": [
        { "include": "#directive-comment" },
        {
          "comment": "Not source.ts#import-declaration: it swallows the line ending after a `//` comment and never ends.",
          "match": "\\bimport\\b(?:\\s+(type)(?!\\s+from))?",
          "name": "keyword.control.import.ts",
          "captures": { "1": { "name": "keyword.control.type.ts" } }
        },
        { "match": "\\bfrom\\b", "name": "keyword.control.from.ts" },
        { "include": "source.ts#string" },
        { "include": "source.ts#import-export-declaration" }
      ]
    },
    "explicit": {
      "begin": "(?<![[:alnum:]])(@)(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.transition.xzor" },
        "2": { "name": "punctuation.section.embedded.begin.xzor" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.xzor" } },
      "contentName": "meta.embedded.expression.typescript",
      "patterns": [{ "include": "source.ts#expression" }]
    },
    "array": {
      "comment": "`@[...]`, scoped like `@( )` so the brackets color the same; a trailing member chain reads as one.",
