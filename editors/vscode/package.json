{
  "name": "xzor",
  "displayName": "XZor",
  "description": "Language support for .xzor components (xzor: Blazor-style components for TypeScript)",
  "version": "0.4.1",
  "publisher": "xzor",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "activationEvents": ["onLanguage:xzor"],
  "contributes": {
    "commands": [{ "command": "xzor.restartServer", "title": "Restart Server", "category": "XZor" }],
    "configuration": {
      "title": "XZor",
      "properties": {
        "xzor.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the xzor executable. Defaults to target/{release,debug}/xzor in the workspace, then the binary installed from npm (node_modules/@source-crafter/xzor-cli-<platform>), then xzor on PATH."
        }
      }
    },
    "languages": [
      {
        "id": "xzor",
        "aliases": ["XZor", "xzor"],
        "extensions": [".xzor"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xzor",
        "scopeName": "source.xzor",
        "path": "./syntaxes/xzor.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.expression.typescript": "typescript",
          "meta.embedded.line.typescript": "typescript"
        },
        "unbalancedBracketScopes": [
          "keyword.operator.relational",
          "storage.type.function.arrow",
          "keyword.operator.bitwise.shift",
          "meta.brace.angle",
          "punctuation.definition.tag",
          "keyword.operator.assignment.compound.bitwise.ts"
        ]
      }
    ]
  }
}
