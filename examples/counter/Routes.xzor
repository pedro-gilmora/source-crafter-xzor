@import Shell from "./layouts/Shell.xzor"
@import MainLayout from "./layouts/MainLayout.xzor"
@import AdminLayout from "./layouts/AdminLayout.xzor"

@* The app's routes: which layout each page renders in, plus the pages that have no component. *@
<Shell>
  @Routes(route) {
    @admin(page) { <AdminLayout>@page</AdminLayout> }
    @"/legal/:doc" { <article class="legal"><h2>Legal: @route.params.doc</h2></article> }
    @/^\/old-(?<slug>[\w-]+)$/ { <p class="moved">"@route.match.slug" has moved. <a href="/">Go home</a></p> }
    @notFound { <p class="missing">No page at @route.path</p> }
    @catch(e) { <p class="error">This page failed: @(String(e))</p> }
    @default(page) { <MainLayout>@page</MainLayout> }
  }
</Shell>
