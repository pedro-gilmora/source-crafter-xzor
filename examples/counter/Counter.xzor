@import { type EventCallback } from "@source-crafter/xzor-runtime"
@import { type IDatabase, type UnitOfWork } from "./services/data"
@import { type AuthService } from "./services/auth"
@inject IDatabase db
@inject AuthService auth
@inject UnitOfWork work

@code {
  label: string = "Count";
  step: number = 1;
  count: number = 0;
  onChange?: EventCallback<number>;

  protected override onInitialized(): void {
    this.count = 0;
  }

  increment() {
    this.count += this.step;
    this.work.track();
    this.onChange?.(this.count);
  }
}

<div class="counter">
  <h2>@label: @count</h2>
  <small class="db">@db.name</small>
  <small class="request">@auth.requestId</small>
  <small class="changes">@work.changes changes</small>
  <button @onclick="increment">+@step</button>
  <button @onclick="() => count = 0" disabled="@(count === 0)">reset</button>
  @if (count >= 10) {
    <p class="hint">That's a lot of clicks.</p>
  } else if (count > 0) {
    <p>Keep going.</p>
  }
  @switch (count % 3) {
    case 0:
      <small>fizz</small>
      break;
    case 1:
    case 2:
      <small>@(count % 3) to go</small>
      break;
  }
</div>
