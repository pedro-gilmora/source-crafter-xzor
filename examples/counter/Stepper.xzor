@import { type EventCallback } from "@xzor/runtime"

@code {
  value: number = 0;
  valueChanged?: EventCallback<number>;

  change(by: number) {
    this.valueChanged?.(this.value + by);
  }
}

<span class="stepper">
  <button @onclick="() => change(-1)" disabled="@(value <= 1)">-</button>
  <b>@value</b>
  <button @onclick="() => change(1)">+</button>
</span>
