@import { type EventCallback } from "@zor/runtime"

@code {
  label: string = "Count";
  step: number = 1;
  count: number = 0;
  onChange?: EventCallback<number>;

  increment() {
    this.count += this.step;
    this.onChange?.(this.count);
  }
}

<div class="counter">
  <h2>@label: @count</h2>
  <button @onclick="increment">+@step</button>
  <button @onclick="() => count = 0" disabled="@(count === 0)">reset</button>
  @if (count >= 10) {
    <p class="hint">That's a lot of clicks.</p>
  } else if (count > 0) {
    <p>Keep going.</p>
  }
  @switch (count % 3) {
    case 0:
      <small>fizz</small>
      break;
    case 1:
    case 2:
      <small>@(count % 3) to go</small>
      break;
  }
</div>
