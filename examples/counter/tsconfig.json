{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [".", ".xzor"],
    "paths": {
      "@xzor/runtime": ["../../runtime/index.ts"]
    }
  },
  "include": ["**/*.ts", ".xzor/**/*.ts"],
  "exclude": ["dist"]
}

