{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "rootDirs": [".", ".zor"],
    "paths": {
      "@zor/runtime": ["../../runtime/index.ts"]
    }
  },
  "include": ["**/*.ts", ".zor/**/*.ts"],
  "exclude": ["dist"]
}
