@import Greeting from "./Greeting.xzor"
@import MainLayout from "./layouts/MainLayout.xzor"
@import AdminLayout from "./layouts/AdminLayout.xzor"
@import { NavLink } from "@xzor/runtime"
@import { href } from "./routes"
@import { type Theme } from "./services/theme"

@code {
  theme: Theme = "light";

  toggleTheme() {
    this.theme = this.theme === "light" ? "dark" : "light";
  }
}

<header class="shell">
  <nav class="site">
    <NavLink href="/" match="exact">Home</NavLink>
    <NavLink href="@href.UserPage({ id: 1 })">User 1</NavLink>
    <NavLink href="@href.AdminHome({})">Admin</NavLink>
    <NavLink href="/legal/terms">Terms</NavLink>
    <NavLink href="/old-pricing">Old link</NavLink>
    <NavLink href="/boom">Broken page</NavLink>
    <NavLink href="/nowhere">Missing</NavLink>
  </nav>
  <button class="theme" @onclick="toggleTheme">@theme theme</button>
  <Greeting />
</header>
@* Every page below sees the theme, and the router publishes `route` the same way. *@
@cascade:theme(theme) {
  @ClientRoutes(route) {
    @admin(page) { <AdminLayout>@page</AdminLayout> }
    @"/legal/:doc" { <article class="legal"><h2>Legal: @route.params.doc</h2></article> }
    @/^\/old-(?<slug>[\w-]+)$/ { <p class="moved">"@route.match.slug" has moved. <a href="/">Go home</a></p> }
    @notFound { <p class="missing">No page at @route.path</p> }
    @catch(e) { <p class="error">This page failed: @(String(e))</p> }
    @default(page) { <MainLayout>@page</MainLayout> }
  }
}
