@import NavBar from "@source-crafter/xzor-ui/NavBar.xzor"
@import NavItem from "@source-crafter/xzor-ui/NavItem.xzor"
@import Button from "@source-crafter/xzor-ui/Button.xzor"
@import Avatar from "@source-crafter/xzor-ui/Avatar.xzor"
@import { currentTheme, toggleTheme } from "@source-crafter/xzor-ui"
@import { href } from "../routes"

@code {
  theme = currentTheme();

  flip() {
    this.theme = toggleTheme();
  }
}

<div class="shell">
  <NavBar kind="side" label="Sections">
    <div class="brand"><span class="logo"></span>Pulse</div>
    <NavItem href="@href.Overview()" label="Overview" icon="chart" match="exact" />
    <NavItem href="@href.Orders()" label="Orders" icon="package" />
    <span class="xz-spacer"></span>
    <div class="me">
      <Avatar name="Margaret Hamilton" size="sm" />
      <span class="me-name">Margaret</span>
      <Button variant="ghost" size="sm" icon="@(theme === 'dark' ? 'sun' : 'moon')" label="@(theme === 'dark' ? 'Use light theme' : 'Use dark theme')" onClick="flip" />
    </div>
  </NavBar>
  <main class="content">@slot</main>
</div>
