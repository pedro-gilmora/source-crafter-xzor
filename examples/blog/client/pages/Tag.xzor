@page "/tags/:tag"
@import PostCard from "../layouts/PostCard.xzor"
@import Empty from "@source-crafter/xzor-ui/Empty.xzor"
@import { href } from "../../routes"
@import type { IPosts, ITags, PostSummary } from "../../contracts/posts"
@inject IPosts posts
@inject ITags allTags

@code {
  tag = "";
  tags: string[] = [];
  tagged: PostSummary[] = [];
  loading = true;

  protected override async onInitializedAsync() {
    this.tags = await this.allTags.all();
  }

  // Runs on every tag change of this kept instance; a slower answer for an earlier tag is dropped.
  protected override async onParametersSetAsync() {
    const tag = this.tag;
    this.tagged = [];
    this.loading = true;
    const tagged = await this.posts.list({ tag });
    if (tag !== this.tag) return;
    this.tagged = tagged;
    this.loading = false;
  }
}

<header class="intro">
  <h1>#@tag</h1>
  <nav class="tag-list" aria-label="Tags">
    @for (const t of tags) {
      <a href="@href.Tag({ tag: t })" aria-current="@(t === tag ? 'page' : null)">#@t</a>
    }
  </nav>
</header>
@if (loading) {
  <p class="xz-muted" role="status">Loading…</p>
} else if (tagged.length === 0) {
  <Empty title="No posts with this tag" icon="tag"><p><a href="@href.Home()">See every post</a></p></Empty>
} else {
  <div class="posts">
    @for (const post of tagged) {
      <PostCard post="@post" />
    }
  </div>
}
