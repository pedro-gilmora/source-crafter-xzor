@page "/"
@import PostCard from "../layouts/PostCard.xzor"
@import type { IPosts, PostSummary } from "../../contracts/posts"
@inject IPosts posts

@code {
  items: PostSummary[] = [];
  loading = true;
  failed = false;

  protected override async onInitializedAsync() {
    try {
      this.items = await this.posts.list({});
    } catch {
      this.failed = true;
    }
    this.loading = false;
  }
}

<header class="intro">
  <h1>Field Notes</h1>
  <p class="xz-muted">Short notes on building interfaces with modern CSS: glass, popovers, transitions and layout, with no JavaScript doing the styling.</p>
</header>
@if (loading) {
  <p class="xz-muted" role="status">Loading…</p>
} else if (failed) {
  <p class="xz-muted" role="alert">Could not load the posts. Reload to try again.</p>
} else {
  <div class="posts">
    @for (const post of items) {
      <PostCard post="@post" />
    }
  </div>
}
