@import Badge from "@source-crafter/xzor-ui/Badge.xzor"
@import { href } from "../../routes"
@import { day } from "../day"
@import type { PostSummary } from "../../contracts/posts"

@code {
  post!: PostSummary;
}

<article class="card">
  <p class="meta"><time datetime="@post.date">@day(post.date)</time><span>@post.minutes min read</span></p>
  <h2><a href="@href.Post({ slug: post.slug })" style="view-transition-name: post-@post.slug">@post.title</a></h2>
  <p class="summary">@post.summary</p>
  <p class="tags">
    @for (const tag of post.tags) {
      <a href="@href.Tag({ tag })"><Badge tone="accent">#@tag</Badge></a>
    }
  </p>
</article>
